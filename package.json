{
  "name": "arrobuild",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test:validation": "tsx scripts/test-validation.ts",
    "test:errors": "tsx scripts/test-errors.ts",
    "test:security": "tsx scripts/test-security.ts && tsx scripts/test-safe-markdown.tsx && tsx scripts/test-request-body.ts && tsx scripts/test-request-policy.ts && tsx scripts/test-analytics-privacy.ts && node scripts/test-integration-environment.mjs",
