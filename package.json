    "benchmark:ai": "tsx scripts/ai-output-benchmark.ts",
    "benchmark:ai:validate": "tsx scripts/ai-output-benchmark.ts --validate-inputs",
    "test:ai-benchmark": "tsx scripts/test-ai-benchmark.ts",
    "check:release-db": "node scripts/check-release-db.mjs",
    "test:generate": "node scripts/test-generate-api.mjs",
    "test:backend": "node scripts/test-backend-v2.mjs",
    "test:production": "node scripts/test-production-automated.mjs",
    "test:midtrans": "node scripts/test-midtrans.mjs"
